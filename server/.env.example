# Copy to .env (or export in the shell) — nothing here is required for the app to run.

# Port for the HTTP API
PORT=4000
HOST=0.0.0.0

# SQLite file (use :memory: for a throwaway database)
DB_PATH=data/trip-budget.sqlite

# Optional LLM for the natural-language parser.
# Without a key the deterministic rule parser handles every capture, fully offline.
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_MS=20000
# Set to 1 to force the offline rule parser even when a key is present
LLM_DISABLED=0
